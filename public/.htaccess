# Triumph Auto — static SPA on Apache (hoster.by and similar shared hosting)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force https://triumf.by (nginx terminates SSL in front of Apache, so check its header too)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://triumf.by%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://triumf.by%{REQUEST_URI} [L,R=301]

  # SEO / verification files must never fall through to SPA index.html
  RewriteRule ^(robots\.txt|sitemap\.xml|google[a-z0-9]+\.html|yandex_[a-z0-9]+\.html)$ - [L]

  # Lead form API (PHP on shared hosting; Vercel uses api/lead.ts instead)
  RewriteRule ^api/lead$ api/lead.php [L,QSA]

  # Prerendered route shells (SEO / Open Graph for each URL)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # SPA fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/

  RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^(sitemap\.xml)$">
  Header set Content-Type "application/xml; charset=UTF-8"
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
</IfModule>
